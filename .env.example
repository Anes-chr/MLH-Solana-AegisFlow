# ==============================================================================
# AegisFlow Environment Configuration Template (.env.example)
# Copy to .env.local for local development. NEVER commit real secret keys to git.
# ==============================================================================

# 1. Google Gemini AI (Optional — offline deterministic fallback runs automatically if omitted)
# Get a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Solana Network & Devnet RPC Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional: Dedicated Devnet RPC (e.g. Helius free Devnet tier) to avoid public RPC 429 limits
HELIUS_RPC_URL=

# 3. AegisFlow Devnet Vault Keypair (Devnet Liquidity Co-Signer for Swaps)
# DEVNET ONLY — leave blank to auto-use local .devnet-vault-keypair.json or deterministic fallback
VAULT_SECRET_KEY=

# 4. Oracle & Reference Quote Endpoints (Optional)
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_HERMES_API_KEY=
JUPITER_API_KEY=

# 5. Stateless Solana Actions HMAC Secret & Public Origin (Optional)
AEGIS_PLAN_HMAC_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
